{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(just:*)",
      "Bash(trunk build:*)",
      "Bash(trunk serve:*)",
      "Bash(npx playwright:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(release-plz:*)",
      "Bash(node generate_class_map.mjs)",
      "Bash(mkcert:*)",
      "Bash(scoop:*)",
      "WebFetch(domain:daisyui.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/fmt-check.py\""
          }
        ]
      }
    ]
  }
}
